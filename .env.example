# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)
# Vercel에서는 Project → Settings → Environment Variables 에 같은 이름으로 등록합니다.
# 키 값은 코드·채팅·스크린샷에 절대 올리지 마세요.

# AI 키는 둘 중 하나만 있으면 됩니다. (둘 다 있으면 Claude 우선). 없으면 규칙 기반 기본 문장으로 동작
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 선택: 모델 바꾸기 (기본값 Claude=claude-haiku-4-5-20251001, Gemini=gemini-flash-latest)
AI_MODEL=

# 선택: Anthropic 호환 중계 서버 주소 (예: 교육용 게이트웨이). 비우면 공식 API
ANTHROPIC_BASE_URL=

# 선택: 고용24 OpenAPI 인증키 — 채용정보 실시간 연동. 없으면 합성 공고로 동작
WORK24_KEY=
WORK24_BASE_URL=
